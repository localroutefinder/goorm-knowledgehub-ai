VITE_APP_NAME=Goorm KnowledgeHub AI
VITE_APP_ENV=development

# Firebase (client-safe public config)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Realtime Database only (Firestore만 쓰면 비워도 됨)
VITE_FIREBASE_DATABASE_URL=

# Server-side AI providers
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
PERPLEXITY_API_KEY=
# Optional: Google Custom Search for web grounding links
GOOGLE_CSE_ID=

# LM Studio local OpenAI-compatible API (Qwen etc.)
# Start Local Server in LM Studio, then set base URL + loaded model id
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
LMSTUDIO_MODEL=qwen2.5-coder-3b-instruct
LMSTUDIO_API_KEY=lm-studio

# Future backend / RAG integrations
# Neon / Supabase PostgreSQL connection string
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
PINECONE_API_KEY=
QDRANT_URL=
QDRANT_API_KEY=
